#!/bin/bash -e

# Prepare the database (create + migrate + seed on first run) before booting the server.
if [ "$1" == "bin/rails" ] && [ "$2" == "server" ]; then
  echo "Running db:prepare..."
  bin/rails db:prepare
fi

# Remove a stale server pid left by a previous run.
rm -f tmp/pids/server.pid

exec "${@}"